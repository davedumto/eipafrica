# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored for a reason.

# Postgres connection string (Neon)
DATABASE_URL=

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# SMTP (Gmail: use port 465, not 587 — 587 is blocked on some networks)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Vercel Blob (private access) — document storage
BLOB_READ_WRITE_TOKEN=

# Pusher Channels — real-time messaging and notifications
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Shared secret for the deadline-reminder cron route.
# Generate with: openssl rand -base64 32
# Must also be set to the same value in Vercel's project env vars.
CRON_SECRET=
